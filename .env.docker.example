APP_NAME="Бухгалтерія Дитсадка"
APP_ENV=production
APP_KEY=CHANGE_ME_BASE64_APP_KEY
APP_DEBUG=false
APP_URL=https://CHANGE_ME_DOMAIN
APP_LOCALE=uk
APP_FALLBACK_LOCALE=uk
APP_FAKER_LOCALE=uk_UA
APP_TIMEZONE=Europe/Kyiv

# The public HTTPS proxy forwards requests to this loopback port.
APP_BIND=127.0.0.1
APP_PORT=8080

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=kindergarten
DB_USERNAME=kindergarten
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_DATABASE=kindergarten
MYSQL_USER=kindergarten
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

LOG_CHANNEL=stack
LOG_LEVEL=warning
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
ADMIN_NAME=Адміністратор
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_DEMO_USERS=false

KINDERGARTEN_NAME="Заклад дошкільної освіти"
KINDERGARTEN_EDRPOU=
KINDERGARTEN_ADDRESS=
KINDERGARTEN_PHONE=
KINDERGARTEN_EMAIL=
KINDERGARTEN_IBAN=
KINDERGARTEN_BANK_NAME=
